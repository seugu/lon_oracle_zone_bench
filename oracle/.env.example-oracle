# Logos Oracle Zone node - example environment
#
#   set -a; source oracle/.env-oracle; set +a
#   cargo run -p logos-oracle-node --release -- run
#
# Every value here has a matching CLI flag; the flag wins if both are given.

# --- Your Logos node -------------------------------------------------------
# Run your own node joined to the PUBLIC TESTNET (bootstrap peers and the
# faucet are in oracle/README.md). This is the node the oracle posts through.
ORACLE_NODE_URL=http://localhost:8080
ORACLE_NODE_AUTH_USERNAME=
ORACLE_NODE_AUTH_PASSWORD=

# --- Who pays the gas ------------------------------------------------------
# A wallet key the node controls: `grep -A3 known_keys user_config.yaml`.
# Fund it at https://testnet.blockchain.logos.co/web/faucet/ first.
# Leave empty for fee-less transactions (accepted only while gas is zero).
ORACLE_FUNDING_PK=
ORACLE_MAX_TX_FEE=1000000
ORACLE_PRIORITY_FEE=200

# --- This oracle's identity ------------------------------------------------
# Both files are created on first run, mode 0600. Losing the Ed25519 key
# means losing write access to the channel permanently.
ORACLE_CHANNEL_KEY_PATH=./data/oracle-channel.ed25519
ORACLE_ATTESTATION_KEY_PATH=./data/oracle-attestation.bip340

# Leave ORACLE_CHANNEL_ID empty to derive the channel from the two public
# keys (the normal case). Set it only to target an existing channel.
ORACLE_CHANNEL_ID=

ORACLE_CHANNEL_PATH=./data/channel.txt
ORACLE_CHECKPOINT_PATH=./data/oracle.checkpoint

# --- The feed --------------------------------------------------------------
# The price itself is hardcoded to 9412345000 in oracle/src/record.rs.
ORACLE_PAIR=BTC/USD
ORACLE_DECIMALS=8
ORACLE_INTERVAL_SECS=30

# --- watch -----------------------------------------------------------------
# Pin the oracle's BIP-340 x-only key instead of learning it from the
# channel's announcement (`... identity` prints it).
ORACLE_EXPECT_WRITER=
